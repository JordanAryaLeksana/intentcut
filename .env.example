# Replace CHANGE_ME locally. Never commit real credentials.
# Use the same URL-safe password in all three connection settings.
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+psycopg://intentcut:CHANGE_ME@127.0.0.1:5432/intentcut
TEST_DATABASE_URL=postgresql+psycopg://intentcut:CHANGE_ME@127.0.0.1:5433/intentcut_test
MEDIA_ROOT=.local/media
MODEL_API_KEY=your_actual_meta_api_key
# AI job reads are disabled by default. Local CLI access only; see M2B8_API.md.
AI_JOBS_LOCAL_ENABLED=false
# Explicit paid-processing opt-in; also requires MODEL_API_KEY and FFmpeg tools.
AI_PROCESSING_ENABLED=false
# Explicit browser-based opt-in; also requires MODEL_API_KEY and FFmpeg tools.
AI_JOBS_BROWSER_ENABLED=true
# CORS_ORIGINS is a JSON array of allowed origins for cross-origin requests.
CORS_ORIGINS='["http://localhost:3001","http://127.0.0.1:3000","http://127.0.0.1:3001","http://127.0.0.1:3021"]'
# Large-footage demo — local only
MAX_FILE_BYTES=10737418240
MAX_REQUEST_BYTES=11811160064
HIGHLIGHT_MAX_SOURCE_BYTES=10737418240
HIGHLIGHT_MAX_DURATION_SECONDS=21600